# Публичный адрес сайта: используется для Open Graph и canonical-ссылок.
# SITE_URL=https://example.com

# Зеркало AnimeGO. По умолчанию используется https://animego.me.
# Укажите другой домен, если основное зеркало заблокировано.
# ANIMEGO_MIRROR=https://animego.me

# Письма: код подтверждения почты при регистрации и код сброса пароля.
# Без SMTP_HOST подтверждение почты отключено (регистрация сразу доступна).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@animehub.local
# SMTP_SECURE=false

# Вход через Яндекс ID (OAuth2). Создайте приложение: https://oauth.yandex.ru/client/new
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://your-site/api/auth/yandex/callback

# Вход через ВКонтакте (VK ID / VK Connect). Создайте приложение: https://vk.com/editapp
# VK_ID_CLIENT_ID=
# VK_ID_CLIENT_SECRET=
# VK_ID_REDIRECT_URI=https://your-site/api/auth/vk/callback

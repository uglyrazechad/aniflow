{
  "name": "anihub-desktop",
  "productName": "AniHub",
  "version": "0.1.2",
  "description": "AniHub для Windows: каталог, плеер и комнаты совместного просмотра",
  "author": "AniHub",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.anihub.desktop",
    "productName": "AniHub",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AniHub",
      "artifactName": "anihub-setup.${ext}"
    },
    "portable": {
      "artifactName": "anihub-windows.${ext}"
    }
  }
}